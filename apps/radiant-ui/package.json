{
	"name": "@ecopages/radiant-ui-docs",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "pnpm --filter @ecopages/radiant-ui build:lib && pnpm --filter @ecopages/radiant-themes build:lib && pnpm run sync:theme-assets && ecopages dev",
		"build": "pnpm --filter @ecopages/radiant-ui build:lib && pnpm --filter @ecopages/radiant-themes build:lib && pnpm run sync:theme-assets && pnpm run generate:llms && ecopages build",
		"preview": "pnpm run generate:llms && ecopages preview",
		"test": "vitest run",
		"test:a11y": "node --test ./scripts/theme-picker-accessibility.test.mjs",
		"test:all": "pnpm --filter @ecopages/radiant-ui build:lib && pnpm --filter @ecopages/radiant-themes build:lib && pnpm run test",
		"sync:theme-assets": "node ./scripts/copy-theme-assets.mjs",
		"generate:llms": "tsx scripts/generate-llm-docs.ts"
	},
	"devDependencies": {
		"@ecopages/browser-router": "0.2.0",
		"@ecopages/core": "0.2.0",
		"@ecopages/content-processor": "0.2.0",
		"@ecopages/ecopages-jsx": "0.2.0",
		"@ecopages/file-system": "0.2.0",
		"@ecopages/jsx": "workspace:*",
		"@ecopages/postcss-processor": "0.2.0",
		"@ecopages/radiant": "workspace:*",
		"@ecopages/radiant-ui": "workspace:*",
		"@ecopages/radiant-themes": "workspace:*",
		"@rehype-pretty/transformers": "^0.13.2",
		"@types/hast": "^3.0.4",
		"@types/node": "^24.13.2",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"ecopages": "0.2.0",
		"playwright": "^1.62.1",
		"rehype-pretty-code": "^0.14.1",
		"remark-gfm": "^4.0.1",
		"shiki": "^3.20.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.20.6",
		"vite": "^8.1.1",
		"vitest": "^4.1.10",
		"zod": "^4.4.3"
	}
}
