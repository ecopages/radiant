{
	"name": "@ecopages/radiant-ui-docs",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "pnpm run guard:cache && ecopages dev",
		"guard:cache": "tsx ../../scripts/ecopages-invalidate-stale-cache.mts",
		"verify:html": "tsx ../../scripts/ecopages-assert-rendered-html.mts dist",
		"build": "pnpm run guard:cache && pnpm run generate:llms && ecopages build && pnpm run verify:html",
		"preview": "pnpm run guard:cache && pnpm run generate:llms && ecopages preview",
		"test": "vitest run",
		"generate:llms": "tsx scripts/generate-llm-docs.ts"
	},
	"devDependencies": {
		"@ecopages/browser-router": "0.2.0-rc.0",
		"@ecopages/core": "0.2.0-rc.0",
		"@ecopages/content-processor": "0.2.0-rc.0",
		"@ecopages/ecopages-jsx": "0.2.0-rc.0",
		"@ecopages/file-system": "0.2.0-rc.0",
		"@ecopages/jsx": "workspace:*",
		"@ecopages/postcss-processor": "0.2.0-rc.0",
		"@ecopages/radiant": "workspace:*",
		"@ecopages/radiant-ui": "workspace:*",
		"@types/hast": "^3.0.4",
		"@types/node": "^24.13.2",
		"ecopages": "0.2.0-rc.0",
		"happy-dom": "^20.0.0",
		"rehype-pretty-code": "^0.14.1",
		"remark-gfm": "^4.0.1",
		"shiki": "^3.20.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.20.6",
		"unist-util-visit": "^5.1.0",
		"vitest": "^4.1.10",
		"zod": "^4.4.3"
	}
}
