{
	"name": "radiant-docs",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/ecopages/radiant"
	},
	"scripts": {
		"start": "bun run app.ts",
		"dev": "bun run app.ts --dev",
		"build": "bun generate:llms && bun run app.ts --build",
		"preview": "bun generate:llms && bun run app.ts --preview",
		"test:e2e": "node --test ./test/*.e2e.test.mjs",
		"watch:dev": "bun --watch run app.ts --dev",
		"generate:llms": "bun run scripts/generate-llm-docs.ts"
	},
	"devDependencies": {
		"@ecopages/browser-router": "^0.2.0-alpha.10",
		"@ecopages/core": "^0.2.0-alpha.10",
		"@ecopages/file-system": "^0.2.0-alpha.10",
		"@ecopages/jsx": "workspace:*",
		"@ecopages/postcss-processor": "^0.2.0-alpha.10",
		"@ecopages/radiant": "workspace:*",
		"@ecopages/scripts-injector": "^0.1.5",
		"@mdx-js/esbuild": "^3.1.1",
		"@mdx-js/mdx": "^2.3.0",
		"@tailwindcss/postcss": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^3.20.0",
		"tailwindcss": "^4.1.18"
	}
}
