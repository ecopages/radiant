{
	"name": "radiant-docs",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/ecopages/radiant"
	},
	"scripts": {
		"start": "ecopages start",
		"dev": "ecopages dev",
		"build": "pnpm run generate:llms && ecopages build && tsx scripts/create-clean-url-aliases.ts",
		"preview": "pnpm run generate:llms && ecopages preview && tsx scripts/create-clean-url-aliases.ts",
		"watch:dev": "ecopages watch:dev",
		"test:e2e": "node --test ./test/*.e2e.test.mjs",
		"generate:llms": "tsx scripts/generate-llm-docs.ts"
	},
	"devDependencies": {
		"ecopages": "0.2.0-beta.38",
		"@ecopages/browser-router": "0.2.0-beta.38",
		"@ecopages/core": "0.2.0-beta.38",
		"@ecopages/file-system": "0.2.0-beta.38",
		"@ecopages/ecopages-jsx": "0.2.0-beta.38",
		"@ecopages/dev-toolbar": "0.2.0-beta.38",
		"@ecopages/jsx": "workspace:*",
		"@ecopages/postcss-processor": "0.2.0-beta.38",
		"@ecopages/content-processor": "0.2.0-beta.38",
		"@ecopages/radiant": "workspace:*",
		"@ecopages/scripts-injector": "^0.1.5",
		"@mdx-js/esbuild": "^3.1.1",
		"@mdx-js/mdx": "^3.1.1",
		"@tailwindcss/postcss": "^4.0.0",
		"@types/hast": "^3.0.4",
		"@types/node": "^24.13.2",
		"remark-gfm": "^4.0.1",
		"shiki": "^3.20.0",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.20.6",
		"typescript": "catalog:",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"zod": "^4.4.3"
	}
}
