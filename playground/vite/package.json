{
	"name": "playground-vite",
	"private": true,
	"type": "module",
	"scripts": {
		"ensure-styles": "pnpm --filter @ecopages/radiant-ui copy-styles",
		"dev": "pnpm run ensure-styles && vite",
		"build": "cd ../.. && pnpm --filter @ecopages/jsx build:lib && pnpm --filter @ecopages/radiant build:lib && pnpm --filter @ecopages/radiant-ui copy-styles && cd playground/vite && tsc && vite build",
		"preview": "vite preview",
		"test:e2e": "node --test ./test/vite-page.e2e.test.mjs"
	},
	"dependencies": {
		"@ecopages/jsx": "workspace:*",
		"@ecopages/radiant": "workspace:*",
		"@ecopages/radiant-ui": "workspace:*",
		"@ecopages/signals": "workspace:*",
		"@floating-ui/dom": "^1.6.11"
	},
	"devDependencies": {
		"@ecopages/vite-plugin-radiant": "workspace:*",
		"@tailwindcss/vite": "^4.1.18",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"playwright": "^1.52.0",
		"tailwindcss": "^4.1.18",
		"typescript": "catalog:",
		"vite": "^8.1.1",
		"vitest": "^4.1.10"
	}
}
