{
	"name": "@ecopages/radiant-ui",
	"version": "0.0.1-beta.0",
	"description": "Accessible light-DOM UI components built with @ecopages/radiant, documented in Storybook",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css",
		"**/index.js"
	],
	"scripts": {
		"build:framework": "bun run --filter @ecopages/storybook-radiant-vite build",
		"lint": "oxlint",
		"storybook": "bun run build:framework && bunx storybook dev -p 6006",
		"build-storybook": "bun run build:framework && bunx storybook build",
		"test": "vitest run",
		"clean": "rm -rf dist",
		"generate:exports": "bun run ./scripts/generate-exports.ts",
		"build:files": "bun run ./scripts/build.ts",
		"build:types": "tsc -p tsconfig.build.json",
		"build:lib": "bun run generate:exports && bun run clean && bun run build:files && bun run build:types",
		"typecheck": "tsc --noEmit -p tsconfig.app.json"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0"
	},
	"peerDependencies": {
		"@ecopages/jsx": ">=0.3.0-beta.3 <1.0.0",
		"@ecopages/radiant": ">=0.3.0-beta.3 <1.0.0",
		"@ecopages/signals": ">=0.3.0-beta.3 <1.0.0"
	},
	"devDependencies": {
		"@babel/core": "^7.28.0",
		"@babel/plugin-proposal-decorators": "^7.28.0",
		"@babel/preset-typescript": "^7.28.0",
		"@chromatic-com/storybook": "^5.2.1",
		"@ecopages/jsx": "workspace:*",
		"@ecopages/radiant": "workspace:*",
		"@ecopages/signals": "workspace:*",
		"@ecopages/storybook-radiant-vite": "workspace:*",
		"@rolldown/plugin-babel": "^0.2.1",
		"@storybook/addon-a11y": "^10.5.2",
		"@storybook/addon-docs": "^10.5.2",
		"@storybook/addon-vitest": "^10.5.2",
		"@tailwindcss/vite": "^4.1.11",
		"@types/node": "^24.13.2",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"oxlint": "^1.71.0",
		"playwright": "^1.61.1",
		"storybook": "^10.5.2",
		"tailwindcss": "^4.1.11",
		"typescript": "~6.0.2",
		"vite": "^8.1.1",
		"vitest": "^4.1.10"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./alert": {
			"types": "./dist/components/ui/alert/index.d.ts",
			"import": "./dist/components/ui/alert/index.js"
		},
		"./breadcrumb": {
			"types": "./dist/components/ui/breadcrumb/index.d.ts",
			"import": "./dist/components/ui/breadcrumb/index.js"
		},
		"./button": {
