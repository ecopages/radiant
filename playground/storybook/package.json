			"import": "./dist/components/ui/feed/index.js"
		},
		"./grid": {
			"types": "./dist/components/ui/grid/index.d.ts",
			"import": "./dist/components/ui/grid/index.js"
		},
		"./listbox": {
			"types": "./dist/components/ui/listbox/index.d.ts",
			"import": "./dist/components/ui/listbox/index.js"
		},
		"./menu-button": {
			"types": "./dist/components/ui/menu-button/index.d.ts",
			"import": "./dist/components/ui/menu-button/index.js"
		},
		"./menubar": {
			"types": "./dist/components/ui/menubar/index.d.ts",
			"import": "./dist/components/ui/menubar/index.js"
		},
		"./meter": {
			"types": "./dist/components/ui/meter/index.d.ts",
			"import": "./dist/components/ui/meter/index.js"
		},
		"./navigation-menu": {
			"types": "./dist/components/ui/navigation-menu/index.d.ts",
			"import": "./dist/components/ui/navigation-menu/index.js"
		},
		"./radio-group": {
			"types": "./dist/components/ui/radio-group/index.d.ts",
			"import": "./dist/components/ui/radio-group/index.js"
		},
		"./slider": {
			"types": "./dist/components/ui/slider/index.d.ts",
			"import": "./dist/components/ui/slider/index.js"
		},
		"./spinbutton": {
			"types": "./dist/components/ui/spinbutton/index.d.ts",
			"import": "./dist/components/ui/spinbutton/index.js"
		},
		"./switch": {
			"types": "./dist/components/ui/switch/index.d.ts",
			"import": "./dist/components/ui/switch/index.js"
		},
		"./tabs": {
			"types": "./dist/components/ui/tabs/index.d.ts",
			"import": "./dist/components/ui/tabs/index.js"
		},
		"./toolbar": {
			"types": "./dist/components/ui/toolbar/index.d.ts",
			"import": "./dist/components/ui/toolbar/index.js"
		},
		"./tooltip": {
			"types": "./dist/components/ui/tooltip/index.d.ts",
			"import": "./dist/components/ui/tooltip/index.js"
		},
		"./tree": {
			"types": "./dist/components/ui/tree/index.d.ts",
			"import": "./dist/components/ui/tree/index.js"
		},
		"./treegrid": {
			"types": "./dist/components/ui/treegrid/index.d.ts",
			"import": "./dist/components/ui/treegrid/index.js"
		},
		"./window-splitter": {
			"types": "./dist/components/ui/window-splitter/index.d.ts",
			"import": "./dist/components/ui/window-splitter/index.js"
		}
	}
}
