{
	"name": "@ecopages/radiant-ui",
	"version": "0.0.1-beta.0",
	"description": "Accessible light-DOM UI components built with @ecopages/radiant, documented in Storybook",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css",
		"**/index.js"
	],
	"scripts": {
		"build:framework": "pnpm --filter @ecopages/storybook-radiant-vite build",
		"lint": "oxlint",
		"storybook": "pnpm run build:framework && pnpm exec storybook dev -p 6006",
		"build-storybook": "pnpm run build:framework && pnpm exec storybook build",
		"test": "vitest run",
		"clean": "rm -rf dist",
		"generate:exports": "node --import tsx ./scripts/generate-exports.ts",
		"build:files": "node --import tsx ./scripts/build.ts",
		"build:types": "tsc -p tsconfig.build.json",
		"build:lib": "pnpm run generate:exports && pnpm run clean && pnpm run build:files && pnpm run build:types && pnpm run copy-styles",
		"copy-styles": "node --import tsx ./scripts/copy-styles.ts",
		"typecheck": "tsc --noEmit -p tsconfig.app.json"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0"
	},
