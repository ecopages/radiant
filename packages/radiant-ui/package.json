{
	"name": "@ecopages/radiant-ui",
	"version": "0.1.0-rc.10",
	"description": "Accessible light-DOM UI components built with @ecopages/radiant",
	"repository": {
		"type": "git",
		"url": "https://github.com/ecopages/radiant.git",
		"directory": "packages/radiant-ui"
	},
	"license": "MIT",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css",
		"**/index.js"
	],
	"scripts": {
		"build:framework": "pnpm --filter @ecopages/vite-plugin-radiant build:lib && pnpm --filter @ecopages/storybook-radiant-vite build",
		"lint": "oxlint",
		"storybook": "pnpm run build:framework && pnpm --filter @ecopages/storybook-radiant-vite exec storybook dev -p 6006 -c ../radiant-ui/.storybook",
		"build-storybook": "pnpm run build:framework && pnpm --filter @ecopages/storybook-radiant-vite exec storybook build -c ../radiant-ui/.storybook",
		"test": "vitest run",
		"test:all": "pnpm --filter @ecopages/jsx build:lib && pnpm --filter @ecopages/radiant build:lib && pnpm run build:framework && vitest run",
		"test:storybook": "pnpm --filter @ecopages/jsx build:lib && pnpm --filter @ecopages/radiant build:lib && pnpm run build:framework && vitest run --project=storybook",
		"test:ssr": "pnpm --filter @ecopages/jsx build:lib && pnpm --filter @ecopages/radiant build:lib && pnpm run build:framework && vitest run --project=ssr && node --import tsx ./scripts/test-storybook-ssr.ts",
		"test:ssr:smoke": "pnpm --filter @ecopages/jsx build:lib && pnpm --filter @ecopages/radiant build:lib && pnpm run build:framework && node --import tsx ./scripts/test-storybook-ssr.ts --smoke",
		"clean": "rm -rf dist",
		"generate:exports": "node --import tsx ./scripts/generate-exports.ts",
		"build:files": "node --import tsx ./scripts/build.ts",
		"build:types": "tsc -p tsconfig.build.json",
		"build:lib": "pnpm run generate:exports && pnpm run clean && pnpm run build:files && pnpm run build:types && pnpm run copy-styles",
		"copy-styles": "node --import tsx ./scripts/copy-styles.ts",
		"typecheck": "tsc --noEmit -p tsconfig.app.json"
	},
	"peerDependencies": {
		"@ecopages/jsx": ">=0.3.0-rc.5",
		"@ecopages/radiant": ">=0.3.0-rc.5",
		"@ecopages/signals": ">=0.3.0-rc.5"
	},
