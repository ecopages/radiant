{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"types": ["vite/client", "@ecopages/vite-plugin-radiant/client"],
		"allowArbitraryExtensions": true,
		"skipLibCheck": true,
		"useDefineForClassFields": true,
		"experimentalDecorators": false,

		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,

		"jsx": "react-jsx",
		"jsxImportSource": "@ecopages/jsx",

		/* Resolve the Storybook framework from source, not its built `dist/*.d.ts`. A stale
       dist previously red-lined every `*.stories.tsx` with phantom TS2305 errors. */
		"paths": {
			"@/*": ["./src/*"],
			/* Story-only helpers live outside `src` so they never reach `dist` — they import
         Storybook types from a private devDependency. Aliased so stories don't climb out
         with `../../../../`. The Vite side of this mapping lives in `.storybook/aliases.ts`,
         which both `vite.config.ts` and `.storybook/main.ts` import. */
			"@sb/*": ["./.storybook/*"],
			"@ecopages/storybook-radiant-vite": ["../storybook-radiant-vite/src/index.ts"],
			"@ecopages/storybook-radiant-vite/node": ["../storybook-radiant-vite/src/node/index.ts"]
		},

		"strict": true,
		/* Radiant decorators (@prop/@state/@query) assign fields through the decorator
       transform; `!`/`declare` modifiers are rejected by the Vite 8 Babel pipeline. */
		"strictPropertyInitialization": false,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"ignoreDeprecations": "6.0"
	},
	/* `.storybook` is included, not just pulled in transitively by story imports, so that
     `preview.ts` and `main.ts` are typechecked too — no story imports them, so they were
     previously excluded from every `tsc` run. Note the glob: a bare `".storybook"` entry does
     not match, because TypeScript skips dot-prefixed directories. */
	"include": ["src", ".storybook/**/*"]
}
