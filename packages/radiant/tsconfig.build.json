{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "./src",
		"allowImportingTsExtensions": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"paths": {
			"@/*": ["./src/*"],
			"dist/*": ["./dist/*"]
		}
	},
	"include": ["src"],
	"exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
