{
	"name": "@ecopages/radiant",
	"version": "0.3.0-beta.7",
	"repository": {
		"type": "git",
		"url": "https://github.com/ecopages/radiant.git"
	},
	"author": "Andrea Zanenghi",
	"license": "MIT",
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"publishConfig": {
		"access": "public",
		"directory": "dist"
	},
	"scripts": {
		"build:lib": "pnpm run clean && pnpm run build:files && pnpm run build:types",
		"build:files": "node --import tsx ./build.ts",
		"build:types": "pnpm --filter @ecopages/signals build:types && pnpm --filter @ecopages/jsx build:types && tsc -p tsconfig.build.json && tsc-alias",
		"clean": "rm -rf ./dist",
		"watch:lib": "node --import tsx ./build.ts --watch",
		"size:check": "node --import tsx ./check-size.ts",
		"size:report": "node --import tsx ./check-size.ts --report-only",
		"test:standard": "vitest run",
		"test:legacy": "vitest run -- --legacy",
		"test:lib": "pnpm run test:standard && pnpm run test:legacy",
		"test:lib:coverage": "vitest run --coverage --project node && vitest run --coverage --project node -- --legacy"
	},
	"dependencies": {
		"@ecopages/signals": ">=0.3.0-beta.6"
	},
	"devDependencies": {
		"@babel/core": "^7.28.0",
		"@babel/plugin-proposal-decorators": "^7.28.0",
		"@babel/plugin-syntax-typescript": "^7.28.0",
		"@ecopages/jsx": "workspace:*",
		"@ecopages/signals": "workspace:*",
		"@rolldown/plugin-babel": "^0.2.1",
		"@oxc-project/runtime": "^0.141.0",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/user-event": "^14.5.2",
		"@types/node": "^24.13.2",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-istanbul": "^4.1.10",
		"happy-dom": "^20.0.0",
		"tsc-alias": "1.8.10",
		"tsx": "^4.20.6",
		"typescript": "catalog:",
		"esbuild": "^0.28.1",
		"playwright": "^1.52.0",
		"vite": "^8.1.1",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"@ecopages/jsx": ">=0.3.0-beta.6"
	},
	"files": [
		"dist/**"
	],
	"sideEffects": [
		"./dist/client/install-hydrator.js",
		"./dist/server/install-light-dom-shim.js",
		"./dist/server/install-ssr-runtime.js"
	],
	"exports": {
		"./package.json": {
			"import": "./package.json"
		},
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./is-server": {
			"types": "./dist/is-server.d.ts",
			"node": "./dist/is-server-node.js",
			"import": "./dist/is-server.js",
			"default": "./dist/is-server.js"
		},
		"./context": {
			"types": "./dist/context/index.d.ts",
			"import": "./dist/context/index.js"
		},
		"./context/create-context": {
