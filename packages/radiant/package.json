			"import": "./dist/server/install-ssr-runtime.js"
		},
		"./server/render-component": {
			"types": "./dist/server/render-component.d.ts",
			"import": "./dist/server/render-component.js"
		},
		"./server/radiant-element-ssr": {
			"types": "./dist/server/radiant-element-ssr.d.ts",
			"import": "./dist/server/radiant-element-ssr.js"
		},
		"./server/radiant-element-ssr-bridge": {
			"types": "./dist/server/radiant-element-ssr-bridge.d.ts",
			"import": "./dist/server/radiant-element-ssr-bridge.js"
		},
		"./server/render-controller": {
