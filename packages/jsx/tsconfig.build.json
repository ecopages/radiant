{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"types": []
	},
	"include": [
		"./src/index.ts",
		"./src/server.ts",
		"./src/client.ts",
		"./src/jsx-runtime.ts",
		"./src/jsx-dev-runtime.ts",
		"./src/dom-render.ts",
		"./src/dom-render/**/*.ts",
		"./src/factory/**/*.ts",
		"./src/types/**/*.ts",
		"./src/ssr/**/*.ts",
		"./src/hydration/**/*.ts",
		"./src/warnings/**/*.ts"
	]
}
