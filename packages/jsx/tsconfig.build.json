	"compilerOptions": {
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"types": []
	},
	"include": [
		"./src/index.ts",
		"./src/server.ts",
		"./src/client.ts",
		"./src/jsx-runtime.ts",
