{
	"name": "@ecopages/jsx",
	"version": "0.3.0-alpha.7",
	"license": "MIT",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"files": [
		"dist/**",
		"README.md",
		"size-budget.json",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./jsx-runtime": {
			"types": "./dist/jsx-runtime.d.ts",
			"import": "./dist/jsx-runtime.js"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/jsx-dev-runtime.d.ts",
			"import": "./dist/jsx-dev-runtime.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:lib": "bun run clean && bun run build:files && bun run build:types",
		"build:files": "bun run ./build.ts",
		"build:types": "tsc -p tsconfig.build.json && bun run ./rewrite-dts-imports.ts",
		"bench:server": "bun run benchmarks/run-all.ts",
		"bench:server:bun": "bun run benchmarks/ssr.ts",
		"bench:server:compare": "bun run benchmarks/run.ts",
		"bench:server:node": "node --import tsx benchmarks/ssr.ts",
		"clean": "rm -rf ./dist",
		"profile:hydrate": "bun run profile:hydrate:bun && bun run profile:hydrate:node",
		"profile:hydrate:bun": "bun run benchmarks/profile-hydrate.ts",
		"profile:hydrate:node": "node --import tsx benchmarks/profile-hydrate.ts",
		"size:check": "bun run ./check-size.ts",
		"size:report": "bun run ./check-size.ts --report-only",
		"test:lib": "vitest run",
		"test:custom-elements": "vitest run test/custom-elements.e2e.test.tsx",
		"test:e2e": "vitest run test/events.e2e.test.tsx",
		"watch:lib": "bun run ./build.ts --watch"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@vitest/browser": "^3.2.4",
		"mitata": "^1.0.34",
		"playwright": "^1.52.0",
		"tsx": "^4.20.6",
		"vite": "^7.1.3",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
