{
	"name": "@ecopages/jsx",
	"version": "0.1.0",
	"module": "index.ts",
	"types": "index.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.ts",
			"import": "./index.ts"
		},
		"./jsx-runtime": {
			"types": "./jsx-runtime.ts",
			"import": "./jsx-runtime.ts"
		},
		"./jsx-dev-runtime": {
			"types": "./jsx-dev-runtime.ts",
			"import": "./jsx-dev-runtime.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"bench:server": "bun run benchmarks/run.ts",
		"bench:server:bun": "bun run benchmarks/ssr.ts",
		"bench:server:node": "node --import tsx benchmarks/ssr.ts",
		"profile:hydrate": "bun run profile:hydrate:bun && bun run profile:hydrate:node",
		"profile:hydrate:bun": "bun run benchmarks/profile-hydrate.ts",
		"profile:hydrate:node": "node --import tsx benchmarks/profile-hydrate.ts",
		"test:lib": "vitest run",
		"test:e2e": "vitest run test/events.e2e.test.tsx"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@vitest/browser": "^3.2.4",
		"lit": "^3.3.2",
		"mitata": "^1.0.34",
		"playwright": "^1.52.0",
		"tsx": "^4.20.6",
		"vite": "^7.1.3",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
