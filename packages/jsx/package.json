{
	"name": "@ecopages/jsx",
	"version": "0.3.0-beta.5",
	"license": "MIT",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"publishConfig": {
		"access": "public",
		"directory": "dist"
	},
	"files": [
		"dist/**"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./jsx-runtime": {
			"types": "./dist/jsx-runtime.d.ts",
			"import": "./dist/jsx-runtime.js"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/jsx-dev-runtime.d.ts",
			"import": "./dist/jsx-dev-runtime.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:lib": "pnpm run clean && pnpm run build:files && pnpm run build:types",
		"build:files": "node --import tsx ./build.ts",
		"build:types": "tsc -p tsconfig.build.json && node --import tsx ./rewrite-dts-imports.ts",
		"bench:server": "node --import tsx benchmarks/run-all.ts",
		"bench:server:bun": "bun run benchmarks/ssr.ts",
		"bench:server:compare": "node --import tsx benchmarks/run.ts",
		"bench:server:node": "node --import tsx benchmarks/ssr.ts",
		"clean": "rm -rf ./dist",
		"profile:hydrate": "pnpm run profile:hydrate:bun && pnpm run profile:hydrate:node",
		"profile:hydrate:bun": "bun run benchmarks/profile-hydrate.ts",
		"profile:hydrate:node": "node --import tsx benchmarks/profile-hydrate.ts",
		"size:check": "node --import tsx ./check-size.ts",
		"size:report": "node --import tsx ./check-size.ts --report-only",
		"test:dist": "pnpm run build:files && vitest run test/dom-render-dist-parity.browser.test.tsx --config vitest.browser.config.ts",
		"test:lib": "vitest run && vitest run --config vitest.browser.config.ts && vitest run --config vitest.e2e.config.ts",
		"test:custom-elements": "vitest run --config vitest.e2e.config.ts test/custom-elements.e2e.test.tsx",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"watch:lib": "node --import tsx ./build.ts --watch"
	},
	"devDependencies": {
		"@ecopages/signals": "workspace:*",
		"@types/node": "^24.13.2",
		"esbuild": "^0.28.1",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"happy-dom": "^20.0.0",
		"mitata": "^1.0.34",
		"playwright": "^1.52.0",
		"tsx": "^4.20.6",
		"vite": "^8.1.1",
		"vitest": "^4.1.10",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@ecopages/signals": ">=0.3.0-beta.5"
	}
}
